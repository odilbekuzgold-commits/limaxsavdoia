# =============================================================================
# LImax AI Manager — Environment Variables Template
# Nusxa oling: cp .env.example .env
# Hech qachon real qiymatlarni bu faylga yozmang!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://limax_user:CHANGE_ME@localhost:5432/limax_db
POSTGRES_USER=limax_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=limax_db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MINIO (Object Storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=limax-media
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# JWT / AUTH
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=CHANGE_ME_ANOTHER_VERY_LONG_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=localhost
NODE_ENV=development

# Repository driver: memory | postgres
# Test/Local: memory, Production/VPS: postgres
REPOSITORY_DRIVER=memory
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# DASHBOARD (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
DASHBOARD_API_URL=http://localhost:4000
# API va dashboard o'rtasidagi kamida 32 belgili ichki token.
INTERNAL_API_TOKEN=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_TOKEN
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# AI PROVIDERS
# -----------------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5

# Active AI provider: openai | gemini | claude
AI_PROVIDER=openai

# Stage 5 AI Orchestration & RAG Configuration
AI_MODE=mock
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CONFIDENCE_THRESHOLD=0.65
AI_MAX_CONTEXT_MESSAGES=20

EMBEDDING_PROVIDER=mock
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004
RAG_TOP_K=5
RAG_MIN_SCORE=0.70

# -----------------------------------------------------------------------------
# TELEGRAM (Stage 4 Telegram Business MVP)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME
TELEGRAM_UPDATE_MODE=polling
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_POLL_LIMIT=50
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
TELEGRAM_DEV_ALLOW_REGULAR_MESSAGES=true
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_PER_CHAT_RATE_LIMIT=10
TELEGRAM_MESSAGE_DEBOUNCE_MS=750

# Natural Human Response Delay (Simulates human typing time)
RESPONSE_DELAY_ENABLED=true
RESPONSE_DELAY_MIN_MS=2000
RESPONSE_DELAY_MAX_MS=6000
RESPONSE_DELAY_PER_CHAR_MS=25

# -----------------------------------------------------------------------------
# WHATSAPP (Meta Cloud API)
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# META ADS (Integration)
# -----------------------------------------------------------------------------
META_ADS_ACCESS_TOKEN=CHANGE_ME
META_ADS_ACCOUNT_ID=CHANGE_ME

# -----------------------------------------------------------------------------
# GOOGLE SHEETS (Integration)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=CHANGE_ME
GOOGLE_PRIVATE_KEY=CHANGE_ME
GOOGLE_SPREADSHEET_ID=CHANGE_ME

# -----------------------------------------------------------------------------
# WORKER
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_PORT=4001

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
